<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyroom.mapper.OperationLogMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `operation_log`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="operatorId != null">`operator_id`,</if>
            <if test="module != null">`module`,</if>
            <if test="action != null">`action`,</if>
            <if test="targetId != null">`target_id`,</if>
            <if test="beforeData != null">`before_data`,</if>
            <if test="afterData != null">`after_data`,</if>
            <if test="ip != null">`ip`,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="operatorId != null">#{operatorId},</if>
            <if test="module != null">#{module},</if>
            <if test="action != null">#{action},</if>
            <if test="targetId != null">#{targetId},</if>
            <if test="beforeData != null">#{beforeData},</if>
            <if test="afterData != null">#{afterData},</if>
            <if test="ip != null">#{ip},</if>
        </trim>
    </insert>
    <select id="selectById" resultType="com.studyroom.model.OperationLog">
        SELECT `id`,
        `operator_id`,
        `module`,
        `action`,
        `target_id`,
        `before_data`,
        `after_data`,
        `ip`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `operation_log` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>
    <update id="update">
        UPDATE `operation_log` SET `operator_id` = #{operatorId},
        `module` = #{module},
        `action` = #{action},
        `target_id` = #{targetId},
        `before_data` = #{beforeData},
        `after_data` = #{afterData},
        `ip` = #{ip}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <update id="deleteById">
        UPDATE `operation_log` SET `is_deleted` = 1, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <select id="selectPage" resultType="com.studyroom.model.OperationLog">
        SELECT `id`,
        `operator_id`,
        `module`,
        `action`,
        `target_id`,
        `before_data`,
        `after_data`,
        `ip`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `operation_log` WHERE `is_deleted` = 0
        ORDER BY `id` DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `operation_log` WHERE `is_deleted` = 0
    </select>
</mapper>
