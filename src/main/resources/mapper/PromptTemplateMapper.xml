<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyroom.mapper.PromptTemplateMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `prompt_template`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateCode != null">`template_code`,</if>
            <if test="version != null">`version`,</if>
            <if test="content != null">`content`,</if>
            <if test="isActive != null">`is_active`,</if>
            <if test="remark != null">`remark`,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="templateCode != null">#{templateCode},</if>
            <if test="version != null">#{version},</if>
            <if test="content != null">#{content},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <select id="selectById" resultType="com.studyroom.model.PromptTemplate">
        SELECT `id`,
        `template_code`,
        `version`,
        `content`,
        `is_active`,
        `remark`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `prompt_template` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>
    <update id="update">
        UPDATE `prompt_template` SET `template_code` = #{templateCode},
        `version` = #{version},
        `content` = #{content},
        `is_active` = #{isActive},
        `remark` = #{remark}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <update id="deleteById">
        UPDATE `prompt_template` SET `is_deleted` = 1, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <select id="selectPage" resultType="com.studyroom.model.PromptTemplate">
        SELECT `id`,
        `template_code`,
        `version`,
        `content`,
        `is_active`,
        `remark`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `prompt_template` WHERE `is_deleted` = 0
        ORDER BY `id` DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `prompt_template` WHERE `is_deleted` = 0
    </select>
</mapper>
