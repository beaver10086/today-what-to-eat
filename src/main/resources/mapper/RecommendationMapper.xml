<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyroom.mapper.RecommendationMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `recommendation`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="requestNo != null">`request_no`,</if>
            <if test="userId != null">`user_id`,</if>
            <if test="mealType != null">`meal_type`,</if>
            <if test="budgetMax != null">`budget_max`,</if>
            <if test="weather != null">`weather`,</if>
            <if test="source != null">`source`,</if>
            <if test="isFallback != null">`is_fallback`,</if>
            <if test="llmModel != null">`llm_model`,</if>
            <if test="promptVersion != null">`prompt_version`,</if>
            <if test="costMs != null">`cost_ms`,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="requestNo != null">#{requestNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="mealType != null">#{mealType},</if>
            <if test="budgetMax != null">#{budgetMax},</if>
            <if test="weather != null">#{weather},</if>
            <if test="source != null">#{source},</if>
            <if test="isFallback != null">#{isFallback},</if>
            <if test="llmModel != null">#{llmModel},</if>
            <if test="promptVersion != null">#{promptVersion},</if>
            <if test="costMs != null">#{costMs},</if>
        </trim>
    </insert>
    <select id="selectById" resultType="com.studyroom.model.Recommendation">
        SELECT `id`,
        `request_no`,
        `user_id`,
        `meal_type`,
        `budget_max`,
        `weather`,
        `source`,
        `is_fallback`,
        `llm_model`,
        `prompt_version`,
        `cost_ms`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `recommendation` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>
    <update id="update">
        UPDATE `recommendation` SET `request_no` = #{requestNo},
        `user_id` = #{userId},
        `meal_type` = #{mealType},
        `budget_max` = #{budgetMax},
        `weather` = #{weather},
        `source` = #{source},
        `is_fallback` = #{isFallback},
        `llm_model` = #{llmModel},
        `prompt_version` = #{promptVersion},
        `cost_ms` = #{costMs}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <update id="deleteById">
        UPDATE `recommendation` SET `is_deleted` = 1, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <select id="selectPage" resultType="com.studyroom.model.Recommendation">
        SELECT `id`,
        `request_no`,
        `user_id`,
        `meal_type`,
        `budget_max`,
        `weather`,
        `source`,
        `is_fallback`,
        `llm_model`,
        `prompt_version`,
        `cost_ms`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `recommendation` WHERE `is_deleted` = 0
        ORDER BY `id` DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `recommendation` WHERE `is_deleted` = 0
    </select>
    <resultMap id="candidateDishMap" type="com.studyroom.dto.DishView">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="shopId" javaType="java.lang.Long"/>
            <arg column="shopName" javaType="java.lang.String"/>
            <arg column="canteenId" javaType="java.lang.Long"/>
            <arg column="canteenName" javaType="java.lang.String"/>
            <arg column="dishName" javaType="java.lang.String"/>
            <arg column="price" javaType="java.math.BigDecimal"/>
            <arg column="category" javaType="java.lang.Integer"/>
            <arg column="mealType" javaType="java.lang.Integer"/>
            <arg column="spiceLevel" javaType="java.lang.Integer"/>
            <arg column="calorie" javaType="java.lang.Integer"/>
            <arg column="description" javaType="java.lang.String"/>
            <arg column="imageUrl" javaType="java.lang.String"/>
            <arg column="isSignature" javaType="java.lang.Integer"/>
            <arg column="isAvailable" javaType="java.lang.Integer"/>
            <arg column="rating" javaType="java.math.BigDecimal"/>
        </constructor>
    </resultMap>
    <select id="selectCandidates" resultMap="candidateDishMap">
        SELECT d.`id`, d.`shop_id` AS `shopId`, s.`shop_name` AS `shopName`,
               s.`canteen_id` AS `canteenId`, c.`canteen_name` AS `canteenName`,
               d.`dish_name` AS `dishName`, d.`price`, d.`category`,
               d.`meal_type` AS `mealType`, d.`spice_level` AS `spiceLevel`, d.`calorie`,
               d.`description`, d.`image_url` AS `imageUrl`,
               d.`is_signature` AS `isSignature`, d.`is_available` AS `isAvailable`, d.`rating`
        FROM `dish` d JOIN `shop` s ON s.`id` = d.`shop_id`
        JOIN `canteen` c ON c.`id` = s.`canteen_id`
        WHERE d.`is_deleted` = 0 AND d.`is_available` = 1
          AND s.`is_deleted` = 0 AND s.`status` = 1
          AND c.`is_deleted` = 0 AND c.`status` = 1
          AND MOD(FLOOR(d.`meal_type` / #{mealMask}), 2) = 1
          AND d.`spice_level` &lt;= #{maxSpice}
        <if test="budgetMin != null">AND d.`price` &gt;= #{budgetMin}</if>
        <if test="budgetMax != null">AND d.`price` &lt;= #{budgetMax}</if>
        <if test="excludeDishIds != null and excludeDishIds.size() > 0">
            AND d.`id` NOT IN
            <foreach collection="excludeDishIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </if>
        <if test="dislikeTagIds != null and dislikeTagIds.size() > 0">
            AND NOT EXISTS (SELECT 1 FROM `dish_tag` bad
                WHERE bad.`dish_id` = d.`id` AND bad.`is_deleted` = 0 AND bad.`tag_id` IN
                <foreach collection="dislikeTagIds" item="id" open="(" separator="," close=")">#{id}</foreach>)
        </if>
        <if test="dietType == 1">
            AND (d.`category` = 3 OR EXISTS (SELECT 1 FROM `dish_tag` veg JOIN `tag` vt
                ON vt.`id` = veg.`tag_id` AND vt.`is_deleted` = 0
                WHERE veg.`dish_id` = d.`id` AND veg.`is_deleted` = 0 AND vt.`tag_name` = '素食'))
        </if>
        <if test="dietType == 2">
            AND EXISTS (SELECT 1 FROM `dish_tag` halal JOIN `tag` ht
                ON ht.`id` = halal.`tag_id` AND ht.`is_deleted` = 0
                WHERE halal.`dish_id` = d.`id` AND halal.`is_deleted` = 0 AND ht.`tag_name` = '清真')
        </if>
        ORDER BY d.`is_signature` DESC, d.`rating` DESC, d.`id` ASC
        LIMIT 500
    </select>
</mapper>
