<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyroom.mapper.UserTasteProfileMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user_taste_profile`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">`user_id`,</if>
            <if test="tagId != null">`tag_id`,</if>
            <if test="weight != null">`weight`,</if>
            <if test="source != null">`source`,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="tagId != null">#{tagId},</if>
            <if test="weight != null">#{weight},</if>
            <if test="source != null">#{source},</if>
        </trim>
    </insert>
    <select id="selectById" resultType="com.studyroom.model.UserTasteProfile">
        SELECT `id`,
        `user_id`,
        `tag_id`,
        `weight`,
        `source`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `user_taste_profile` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>
    <update id="update">
        UPDATE `user_taste_profile` SET `user_id` = #{userId},
        `tag_id` = #{tagId},
        `weight` = #{weight},
        `source` = #{source}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <update id="deleteById">
        UPDATE `user_taste_profile` SET `is_deleted` = 1, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <select id="selectPage" resultType="com.studyroom.model.UserTasteProfile">
        SELECT `id`,
        `user_id`,
        `tag_id`,
        `weight`,
        `source`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `user_taste_profile` WHERE `is_deleted` = 0
        ORDER BY `id` DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `user_taste_profile` WHERE `is_deleted` = 0
    </select>
    <select id="selectAllByUserId" resultType="com.studyroom.model.UserTasteProfile">
        SELECT `id`, `user_id`, `tag_id`, `weight`, `source`, `create_time`, `update_time`, `is_deleted`
        FROM `user_taste_profile` WHERE `user_id` = #{userId}
    </select>
    <select id="selectByUserId" resultType="com.studyroom.model.UserTasteProfile">
        SELECT `id`, `user_id`, `tag_id`, `weight`, `source`, `create_time`, `update_time`, `is_deleted`
        FROM `user_taste_profile` WHERE `user_id` = #{userId} AND `is_deleted` = 0
    </select>
    <update id="setDeleted">
        UPDATE `user_taste_profile` SET `is_deleted` = #{isDeleted}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id}
    </update>
</mapper>
