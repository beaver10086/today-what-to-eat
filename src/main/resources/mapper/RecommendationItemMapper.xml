<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.studyroom.mapper.RecommendationItemMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `recommendation_item`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recommendationId != null">`recommendation_id`,</if>
            <if test="dishId != null">`dish_id`,</if>
            <if test="shopId != null">`shop_id`,</if>
            <if test="rankNo != null">`rank_no`,</if>
            <if test="score != null">`score`,</if>
            <if test="reason != null">`reason`,</if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recommendationId != null">#{recommendationId},</if>
            <if test="dishId != null">#{dishId},</if>
            <if test="shopId != null">#{shopId},</if>
            <if test="rankNo != null">#{rankNo},</if>
            <if test="score != null">#{score},</if>
            <if test="reason != null">#{reason},</if>
        </trim>
    </insert>
    <select id="selectById" resultType="com.studyroom.model.RecommendationItem">
        SELECT `id`,
        `recommendation_id`,
        `dish_id`,
        `shop_id`,
        `rank_no`,
        `score`,
        `reason`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `recommendation_item` WHERE `id` = #{id} AND `is_deleted` = 0
    </select>
    <update id="update">
        UPDATE `recommendation_item` SET `recommendation_id` = #{recommendationId},
        `dish_id` = #{dishId},
        `shop_id` = #{shopId},
        `rank_no` = #{rankNo},
        `score` = #{score},
        `reason` = #{reason}, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <update id="deleteById">
        UPDATE `recommendation_item` SET `is_deleted` = 1, `update_time` = CURRENT_TIMESTAMP
        WHERE `id` = #{id} AND `is_deleted` = 0
    </update>
    <select id="selectPage" resultType="com.studyroom.model.RecommendationItem">
        SELECT `id`,
        `recommendation_id`,
        `dish_id`,
        `shop_id`,
        `rank_no`,
        `score`,
        `reason`,
        `create_time`,
        `update_time`,
        `is_deleted` FROM `recommendation_item` WHERE `is_deleted` = 0
        ORDER BY `id` DESC LIMIT #{size} OFFSET #{offset}
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM `recommendation_item` WHERE `is_deleted` = 0
    </select>
</mapper>
