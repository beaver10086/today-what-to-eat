{
  "info": { "name": "今天吃什么 API 回归", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [],
  "item": [
    { "name": "健康检查", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('health is UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.status).to.eql('UP'); });"] } }] },
    { "name": "公开菜品列表", "request": { "method": "GET", "url": "{{baseUrl}}/api/dishes?page=1&size=10" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('dish list succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.records).to.be.an('array'); });"] } }] },
    { "name": "按食堂和预算随机挑菜", "request": { "method": "GET", "url": "{{baseUrl}}/api/dishes/random?canteenId=900001&maxPrice=20" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('random dish honors canteen and price filters', () => { pm.response.to.have.status(200); const dish=pm.response.json().data; pm.expect(dish.canteenId).to.eql(900001); pm.expect(Number(dish.price)).to.be.at.most(20); });"] } }] },
    { "name": "未登录推荐应拒绝", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"mealType\":2,\"limit\":3}" }, "url": "{{baseUrl}}/api/recommendations" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('protected endpoint rejects anonymous user', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"] } }] },
    { "name": "注册回归用户并取得 Token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"username\":\"{{$guid}}\",\"password\":\"{{password}}\",\"nickname\":\"API回归\"}" }, "url": "{{baseUrl}}/api/auth/register" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('registration succeeds with ordinary role', () => { pm.response.to.have.status(200); const d=pm.response.json().data; pm.expect(d.token).to.be.a('string'); pm.expect(d.role).to.eql(1); pm.environment.set('token', d.token); pm.environment.set('username', d.username); });"] } }] },
    { "name": "读取菜品详情", "request": { "method": "GET", "url": "{{baseUrl}}/api/dishes/{{dishId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('seed dish exists with description', () => { pm.response.to.have.status(200); const dish=pm.response.json().data; pm.expect(dish.id).to.eql(Number(pm.environment.get('dishId'))); pm.expect(dish.description).to.be.a('string'); });"] } }] },
    { "name": "保存口味问卷", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"maxSpiceLevel\":1,\"budgetMin\":0,\"budgetMax\":30,\"likeTagIds\":[930001],\"dislikeTagIds\":[],\"dietType\":0}" }, "url": "{{baseUrl}}/api/preferences/me" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('preferences persist', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.maxSpiceLevel).to.eql(1); });"] } }] },
    { "name": "读取口味画像", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/preferences/me/profile" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('profile is returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"] } }] },
    { "name": "生成推荐", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"mealType\":2,\"limit\":3,\"budgetMax\":30}" }, "url": "{{baseUrl}}/api/recommendations" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('recommendation is generated', () => { pm.response.to.have.status(200); const d=pm.response.json().data; pm.expect(d.id).to.be.ok; pm.expect(d.items.length).to.be.above(0); pm.environment.set('recommendationId', d.id); pm.environment.set('recommendedDishId', d.items[0].dish.id); });"] } }] },
    { "name": "反馈不喜欢并请求下一组", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"dishId\":{{recommendedDishId}},\"feedbackType\":3,\"reasonTag\":\"API回归\"}" }, "url": "{{baseUrl}}/api/recommendations/{{recommendationId}}/next" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('next recommendation succeeds', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.property('id'); });"] } }] },
    { "name": "添加菜品收藏", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"targetType\":1,\"targetId\":{{dishId}}}" }, "url": "{{baseUrl}}/api/favorites" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('favorite is added', () => pm.response.to.have.status(200));"] } }] },
    { "name": "验证收藏 ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/favorites/ids?targetType=1" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('favorite id is listed', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.include(Number(pm.environment.get('dishId'))); });"] } }] },
    { "name": "移除菜品收藏", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/favorites/1/{{dishId}}" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('favorite is removed', () => pm.response.to.have.status(200));"] } }] },
    { "name": "登出", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/logout" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('logout succeeds', () => pm.response.to.have.status(200));"] } }] }
  ]
}

